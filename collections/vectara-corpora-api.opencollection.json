      },
      "items": [
        {
          "info": {
            "name": "List Corpora",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vectara.io/v2/corpora",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_key",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Corpora"
        },
        {
          "info": {
            "name": "Create A Corpus",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.vectara.io/v2/corpora",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create A Corpus"
        },
        {
          "info": {
            "name": "Retrieve Corpus Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vectara.io/v2/corpora/:corpus_key",
            "params": [
              {
                "name": "corpus_key",
                "value": "",
