          "http": {
            "method": "PATCH",
            "url": "https://api.vectara.io/v2/corpora/:corpus_key",
            "params": [
              {
                "name": "corpus_key",
                "value": "",
                "type": "path",
                "description": "The unique key identifying a corpus."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update A Corpus"
        },
        {
          "info": {
            "name": "Delete A Corpus",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.vectara.io/v2/corpora/:corpus_key",
            "params": [
              {
                "name": "corpus_key",
                "value": "",
                "type": "path",
                "description": "The unique key identifying a corpus."
              }
            ]
          },
          "docs": "Delete A Corpus"
